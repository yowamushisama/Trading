# ─────────────────────────────────────────────
#  BTC Bot — Environment Variables
#  Copy to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Mode ──────────────────────────────────────
# backtest | paper_local | paper_testnet | live
MODE=paper_local

# ── Symbol & Exchange ─────────────────────────
SYMBOL=BTC/USDT
EXCHANGE=binance
# Set true only for paper_testnet mode
BINANCE_TESTNET=false

# ── Binance API Keys ──────────────────────────
# Spot trading only. Withdrawals must be DISABLED. IP-whitelist recommended.
LIVE_API_KEY=your_live_api_key_here
LIVE_API_SECRET=your_live_api_secret_here
TESTNET_API_KEY=your_testnet_api_key_here
TESTNET_API_SECRET=your_testnet_api_secret_here

# ── Live Trading Safety Gates ─────────────────
# BOTH must be true for live orders to be placed. Default: false.
LIVE_TRADING_ENABLED=false
I_UNDERSTAND_LIVE_TRADING_RISK=false

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@db.supabase.co:5432/postgres

# ── LLM (Phase 3) ─────────────────────────────
# anthropic | openai | groq | none
LLM_PROVIDER=none
LLM_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── News (Phase 3) ────────────────────────────
CRYPTOPANIC_TOKEN=
# keyword | llm
NEWS_TAGGER=keyword
NEWS_COOLDOWN_MINUTES=30

# ── Risk Parameters ───────────────────────────
RISK_PER_TRADE_PCT=0.0025        # 0.25% of equity per trade
DAILY_LOSS_CAP_PCT=0.015         # 1.5% — halt trading for the day if hit
WEEKLY_LOSS_CAP_PCT=0.04         # 4%  — halt for the week
MAX_CONSEC_LOSSES=3              # consecutive losses before cooldown
CONSEC_LOSS_COOLDOWN_HOURS=4
MAX_OPEN_POSITIONS=1
ATR_STOP_K=1.5                   # stop = entry - k * ATR
MIN_RR=1.5                       # minimum reward:risk ratio
FEE_PER_SIDE_PCT=0.00075         # 0.075% with BNB; use 0.001 without
SLIPPAGE_BUFFER_BPS=5            # extra buffer in basis points
ALLOW_MARKET_ORDERS=false        # default: limit orders only

# ── Execution ─────────────────────────────────
PROTECTION_TIMEOUT_SECONDS=5     # max time to confirm SL/TP after entry fill
STALE_ORDER_SECONDS_SCALPER=30
STALE_ORDER_SECONDS_SWING=300
RECONCILER_INTERVAL_SECONDS=30

# ── Strategies ────────────────────────────────
# Comma-separated: scalper,swing
STRATEGIES_ENABLED=scalper,swing

# ── Halt Mechanism ────────────────────────────
# Bot checks for HALT file at this path every loop iteration.
# Touch this file or set HALT=true to stop the bot immediately.
HALT_FILE_PATH=./HALT
HALT=false

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
